NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,https://portal.skygem.ai

DATABASE_URL=postgresql://username:password@hostname:5432/skygem?sslmode=require
RDS_CA_PATH=
# Production example: /etc/skygem/global-bundle.pem

# AWS
AWS_REGION=us-east-1

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# SMS
SMS_PROVIDER=console
SMS_FROM_NUMBER=

# Retell — direct key for local development
RETELL_API_KEY=

# Retell — AWS Secrets Manager identifier for production
RETELL_API_KEY_SECRET_ID=

# Webhook verification
RETELL_WEBHOOK_SECRET=
